# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# Host port mapped to the container's 5432 (5433 avoids clashing with a local Postgres)
POSTGRES_PORT=5433

# Backend
# Used when running the backend on the host; docker compose builds its own URL (host "db").
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5433/app
# At least 32 characters for HS256 (48 for HS384, 64 for HS512). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Comma-separated list of allowed browser origins (no "*", no trailing slash)
CORS_ORIGINS=http://localhost:5173
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# Host port for the API container
BACKEND_PORT=8000
